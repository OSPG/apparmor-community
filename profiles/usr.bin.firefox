# Last Modified: Sat Aug  8 00:49:00 2026
include <tunables/global>

/usr/bin/firefox {
  include <abstractions/base>
  include <abstractions/desktop-app>

  capability sys_admin,
  capability sys_chroot,
  capability sys_ptrace,

  /.dumpfile r,
  /bin/basename mrix,
  /bin/uname mrix,
  /dev/ r,
  /etc/fstab r,
  /etc/mailcap r,
  /etc/mime.types r,
  /etc/opensc.conf r,
  /etc/xdg/taskmanagerrulesrc r,
  /sys/bus/ r,
  /sys/class/ r,
  /sys/devices/system/cpu/present r,
  /sys/fs/cgroup/2/* r,
  /sys/fs/cgroup/[0-9]*/cpu.max r,
  /usr/bin/ark PUx,
  /usr/bin/firefox r,
  /usr/bin/plasma-browser-integration-host mrix,
  /usr/bin/speech-dispatcher PUx,
  /usr/lib64/firefox/firefox mrix,
  /usr/lib64/firefox/glxtest mrix,
  /usr/lib64/firefox/pingsender mrix,
  /usr/lib64/firefox/vaapitest mrix,
  /usr/libexec/gio-launch-desktop mrix,
  /usr/share/xkeyboard-config-2/** r,
  @{PROC}/*/uid_map w,
  @{PROC}/@{pid}/* w,
  @{PROC}/@{pid}/** r,
  owner /tmp/ r,
  owner /tmp/** rw,
  owner @{HOME}/ r,
  owner @{HOME}/** r,
  owner @{HOME}/*/.config/menus/ r,
  owner @{HOME}/.cache/mozilla/** rw,
  owner @{HOME}/.mozilla/firefox/** rwlk,
  owner @{HOME}/.mozilla/firefox/*/gmp-widevinecdm/*/libwidevinecdm.so mr,
  owner @{HOME}/Documents/** rw,
  owner @{HOME}/Downloads/** rw,
  owner @{HOME}/Pictures/** rw,
  owner @{run}/user/*/* rw,

  include if exists <local/usr.bin.firefox>

}
